# Anthropic API key - get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Optional: set to "development" locally
NODE_ENV=development

# ── Contact form → email (Web3Forms) ──
# Forwards contact-form submissions to your Google/Gmail inbox.
# Get a free key at https://web3forms.com — enter the destination email
# (e.g. hello@twootters.studio), and they email you the access key. No account needed.
# NEXT_PUBLIC_ prefix is required so the browser can read it; this key is safe to expose.
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# ── Audit flow + the Gmail version of the contact form → email (SMTP) ──
# Who we authenticate to Gmail as. Must be a real mailbox that can hold an App
# Password: an alias cannot. A plain @gmail.com account works.
GMAIL_USER=mqueen.website@gmail.com
# Google Account → Security → 2-Step Verification → App passwords.
# 16 characters. Not the account's own password.
GMAIL_APP_PASSWORD=your_16_char_app_password
# Where submissions land. Defaults to GMAIL_USER when unset.
CONTACT_TO=mqueen.website@gmail.com
# What the visitor sees in the From line. Defaults to GMAIL_USER when unset.
# Gmail only honours a different address if it is a verified "Send mail as"
# identity on that account; otherwise it silently rewrites From back to the login.
MAIL_FROM=

# ── Brand Kit (/brand) — Google Drive source ──
# Until both are set, /brand shows a local mock preview.
# 1. Google Cloud → enable the Drive API → create an API key → restrict it to the Drive API.
GOOGLE_DRIVE_API_KEY=your_drive_api_key_here
# 2. The shared brand-assets Drive folder, set to "Anyone with the link → Viewer".
#    Copy the id from the folder URL: drive.google.com/drive/folders/<THIS_ID>
BRAND_DRIVE_FOLDER_ID=your_root_folder_id_here
