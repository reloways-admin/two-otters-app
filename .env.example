# Anthropic API key - get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Optional: set to "development" locally
NODE_ENV=development

# ── Forms ─────────────────────────────────────────────────────────────────────
# Every form posts to /api/forms/<name>, is recorded by a LeadRecorder and may
# write the visitor into an audience through a Mailer.
#
# Only CREDENTIALS belong here. Which list, board or template each form uses is
# configuration and lives in src/config/integrations.json — a reviewable diff
# rather than a dashboard field. Every id there can be overridden by the
# matching variable below when one deployment needs to differ.
#
# With none of this set, both adapters fall back to their console version
# outside production, so `npm run dev` exercises every form with no credentials.

CLICKUP_TOKEN=pk_your_token_here
BREVO_API_KEY=your_brevo_api_key_here

# Which adapters to use. Defaults: clickup / brevo-group.
# Recorders: clickup, console     Mailers: brevo-group, brevo-transactional, console
LEAD_RECORDER=
MAILER=

# Only needed for MAILER=brevo-transactional, which sends templates itself
# instead of letting a list automation do it. The sender must be verified in
# Brevo or every send is rejected.
BREVO_SENDER_EMAIL=hello@two-otters.studio
BREVO_SENDER_NAME=Two Otters Studio

# Per-deployment overrides of src/config/integrations.json. Leave unset normally.
# CLICKUP_LIST_LEADS=
# MAIL_LIST_AUDIT_CONFIRM=
# MAIL_LIST_CONTACT_CONFIRM=
# MAIL_TEMPLATE_AUDIT_CONFIRM=

# Addresses a mailer must never write to — notifying the team is the lead
# recorder's job. Comma-separated; a domain covers its subdomains.
INTERNAL_MAIL_DOMAINS=two-otters.studio

# ── Booking (/schedule-a-call) — Google Calendar ──
# Who hosts, their hours and time zones live in src/config/booking.ts. These are
# only the credentials. Until all are set, `npm run dev` uses a mock calendar;
# production refuses to book instead (the page then points at the contact form).
# 1. Google Cloud → enable the Calendar API → OAuth client, type "Web application",
#    redirect URI http://localhost:53682/callback. Publish the consent screen
#    ("In production", or "Internal" on Workspace) or tokens expire in 7 days.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 2. Each host connects their own account once:
#    node scripts/google-calendar-token.mjs amir   (and again with: keren)
GOOGLE_REFRESH_TOKEN_AMIR=
GOOGLE_REFRESH_TOKEN_KEREN=
# 3. Optional: more calendars that count as busy for a host, comma-separated.
#    Each must share at least free/busy with that host's connected account.
#    Not secrets. e.g. BOOKING_ALSO_BUSY_AMIR=amir@methodqueen.com
BOOKING_ALSO_BUSY_AMIR=
BOOKING_ALSO_BUSY_KEREN=

# ── Client-side debugging ──
# "1" lets the browser console show form failures. A flag, not a secret.
NEXT_PUBLIC_DEBUG=

# ── Brand Kit (/brand) — Google Drive source ──
# Until both are set, /brand shows a local mock preview.
# 1. Google Cloud → enable the Drive API → create an API key → restrict it to the Drive API.
GOOGLE_DRIVE_API_KEY=your_drive_api_key_here
# 2. The shared brand-assets Drive folder, set to "Anyone with the link → Viewer".
#    Copy the id from the folder URL: drive.google.com/drive/folders/<THIS_ID>
BRAND_DRIVE_FOLDER_ID=your_root_folder_id_here

# ─── Booking: approval flow and email (since 8.10.2026) ──────────────────────
# A booking is a request until both hosts approve it by email. See
# src/lib/booking/requests.ts and docs/integrations.md → "Google Calendar".
# Leave every value empty locally to run on the mock calendar + outbox.

# Where each host's approval emails go. Keren's is also the address invited to
# the confirmed meeting, so it must be her Google calendar's address.
BOOKING_HOST_EMAIL_AMIR=
BOOKING_HOST_EMAIL_KEREN=

# The visitor's invitation (with .ics), decline and expiry emails come from here.
# A Gmail send-as alias works: log in to SMTP as the mailbox that owns it.
BOOKING_FROM_EMAIL=amir@two-otters.studio
BOOKING_FROM_NAME=

# SMTP login for that mailbox. For Gmail: smtp.gmail.com, 587, the full address,
# and a dedicated app password (Google Account → Security → App passwords).
# Without these the site writes mail to .next/cache/booking-outbox instead
# (outside production only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Signs the approve / decline links. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it kills every link already sent.
BOOKING_LINK_SECRET=

# Comma-separated addresses (or @domain) that may receive booking mail. While
# set, mail to anyone else is dropped and logged. Outside production, real SMTP
# with an EMPTY list sends to nobody. Leave empty in Production only.
BOOKING_TEST_ALLOWLIST=

# Protects GET /api/booking/expire (header: Authorization: Bearer <secret>).
# Vercel Cron sends this header automatically when CRON_SECRET is set.
CRON_SECRET=

# Optional. Base URL for links in emails; defaults to the request's own origin.
# BOOKING_BASE_URL=https://two-otters.studio

# Local testing only (ignored in production):
# BOOKING_CALENDAR=mock              use the mock even if Google credentials exist
# BOOKING_CLOCK_OFFSET_HOURS=25      move the clock forward, to watch a request expire
# BOOKING_MOCK_STORE=                mock calendar file (default .next/cache/booking-mock.json)
# BOOKING_OUTBOX_DIR=                outbox folder (default .next/cache/booking-outbox)
